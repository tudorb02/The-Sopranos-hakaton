{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.greenstruct.ro/schemas/event.json",
  "title": "RunEvent",
  "description": "Envelope of one SSE event (GET /api/runs/{id}/events) and of one line in fixtures/*.ndjson. See contracts/events.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "runId",
    "type",
    "agent",
    "at",
    "message",
    "data"
  ],
  "properties": {
    "seq": {
      "description": "Sequence number per dossier, starts at 1, no gaps. Also sent as `id:` in SSE.",
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "type": {
      "type": "string",
      "enum": [
        "state.transition",
        "agent.started",
        "agent.thought",
        "agent.tool_call",
        "agent.tool_result",
        "agent.completed",
        "agent.degraded",
        "run.completed",
        "run.failed"
      ]
    },
    "agent": {
      "description": "null for state.transition and run.*.",
      "anyOf": [
        {
          "$ref": "#/$defs/agent"
        },
        {
          "type": "null"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "message": {
      "description": "The timeline line, in English, ready to display.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "state.transition"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "type": "null"
          },
          "data": {
            "$ref": "#/$defs/stateTransitionData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.started"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/agentStartedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.thought"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/agentThoughtData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.tool_call"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/toolCallData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.tool_result"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/toolResultData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.completed"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/agentCompletedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.degraded"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "$ref": "#/$defs/agent"
          },
          "data": {
            "$ref": "#/$defs/agentDegradedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.completed"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "type": "null"
          },
          "data": {
            "$ref": "#/$defs/runCompletedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.failed"
          }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "type": "null"
          },
          "data": {
            "$ref": "#/$defs/runFailedData"
          }
        }
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-z]{12}$"
    },
    "calcRef": {
      "type": "string",
      "pattern": "^calc_[a-f0-9]{12}$"
    },
    "agent": {
      "type": "string",
      "enum": [
        "TECHNICAL_AUDITOR",
        "FUNDING_OPTIMIZER",
        "GREEN_UNDERWRITER"
      ]
    },
    "runState": {
      "type": "string",
      "enum": [
        "CREAT",
        "DATE_FIRMA",
        "AGENT_1",
        "AGENT_2",
        "AGENT_3",
        "GATA",
        "TRIMIS",
        "APROBAT",
        "MONITORIZARE",
        "ESUAT"
      ]
    },
    "source": {
      "description": "Where the agent output comes from (the live / cache / fallback badge).",
      "type": "string",
      "enum": [
        "LIVE",
        "RETRY",
        "FALLBACK_MODEL",
        "CACHE",
        "GOLDEN"
      ]
    },
    "toolName": {
      "type": "string",
      "enum": [
        "get_module_rules",
        "extract_document",
        "compute_baseline",
        "compute_indicator",
        "search_upgrades",
        "simulate_upgrade_package",
        "check_dnsh_inputs",
        "list_financing_lines",
        "check_program_eligibility",
        "build_funding_stack",
        "build_scenario",
        "compare_scenarios",
        "check_affordability",
        "compare_conversion_plans",
        "compute_liquidity_gap",
        "determine_green_tier",
        "price_loan",
        "compute_dscr",
        "get_labeling_rules",
        "get_dnsh_criteria",
        "calculate_impact",
        "select_fund",
        "check_fund_requirements",
        "get_bond_category",
        "submit_technical_assessment",
        "submit_funding_recommendation",
        "submit_underwriting_report"
      ]
    },
    "toolUseId": {
      "type": "string",
      "pattern": "^tooluse_[A-Za-z0-9_-]{6,64}$"
    },
    "calcResult": {
      "description": "One figure produced by the deterministic engine. The only place where numbers appear; agents reference them by calcId.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calcId",
        "tool",
        "key",
        "labelRo",
        "value",
        "unit",
        "display"
      ],
      "properties": {
        "calcId": {
          "$ref": "#/$defs/calcRef"
        },
        "tool": {
          "$ref": "#/$defs/toolName"
        },
        "key": {
          "description": "Stable, readable key (e.g. option_b.installment).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{2,80}$"
        },
        "labelRo": {
          "type": "string",
          "maxLength": 160
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "EUR",
            "EUR_PER_MONTH",
            "EUR_PER_YEAR",
            "EUR_PER_L",
            "EUR_PER_M3",
            "EUR_PER_KWH",
            "EUR_PER_HA",
            "PCT",
            "PP",
            "RATIO",
            "M3",
            "M3_PER_YEAR",
            "M3_PER_HA",
            "KWH",
            "KWH_PER_YEAR",
            "KWH_PER_M3",
            "KWH_PER_KWP",
            "L",
            "L_PER_YEAR",
            "L_PER_HA",
            "KG_N_PER_YEAR",
            "KG_N_PER_HA",
            "T_CO2",
            "T_CO2_PER_YEAR",
            "KG_CO2_PER_L",
            "KG_CO2_PER_KWH",
            "HA",
            "HP",
            "HP_PER_HA",
            "KW",
            "KWP",
            "MONTHS",
            "YEARS",
            "COUNT",
            "POINTS",
            "KWH_PER_T",
            "KWH_PER_M2",
            "KG_CH4_PER_YEAR",
            "MWH_PER_YEAR",
            "T",
            "M2",
            "EUR_PER_KG",
            "EUR_PER_KG_N"
          ]
        },
        "display": {
          "description": "The value formatted in English (e.g. \"85,000 EUR\", \"15.0%\").",
          "type": "string",
          "maxLength": 60
        },
        "formula": {
          "type": "string",
          "maxLength": 300
        },
        "sourceRo": {
          "description": "Source of the parameter (config, document, catalog).",
          "type": "string",
          "maxLength": 240
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/calcRef"
          }
        },
        "series": {
          "description": "Monthly series (e.g. the repayment schedule). Only for schedule-type calcs.",
          "type": "array",
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "values"
            ],
            "properties": {
              "period": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "payment",
                    "interest",
                    "principal",
                    "balance",
                    "savings"
                  ]
                },
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "stateTransitionData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "actor"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/runState"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "$ref": "#/$defs/runState"
        },
        "actor": {
          "type": "string",
          "enum": [
            "SYSTEM",
            "FARMER",
            "OFFICER"
          ]
        },
        "reasonRo": {
          "type": "string",
          "maxLength": 300
        },
        "dataSources": {
          "description": "Only at DATE_FIRMA: where the company data came from.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "mode"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "ANAF",
                  "APIA",
                  "ANSVSA",
                  "OPEN_BANKING",
                  "COPERNICUS",
                  "NATURA_2000",
                  "NITRATES"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "LIVE",
                  "MOCK",
                  "CACHE"
                ]
              }
            }
          }
        }
      }
    },
    "agentStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "modelId",
        "mode",
        "attempt"
      ],
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "AGENT_1",
            "AGENT_2",
            "AGENT_3"
          ]
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        },
        "mode": {
          "type": "string",
          "enum": [
            "LIVE",
            "HYBRID",
            "REPLAY"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "agentThoughtData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "toolCallData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolUseId",
        "tool",
        "iteration",
        "input"
      ],
      "properties": {
        "toolUseId": {
          "$ref": "#/$defs/toolUseId"
        },
        "tool": {
          "$ref": "#/$defs/toolName"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "input": {
          "description": "The input requested by the model. References ids (config, catalog, calcId), not figures.",
          "type": "object"
        }
      }
    },
    "toolResultData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolUseId",
        "tool",
        "status",
        "durationMs",
        "calcs",
        "result"
      ],
      "properties": {
        "toolUseId": {
          "$ref": "#/$defs/toolUseId"
        },
        "tool": {
          "$ref": "#/$defs/toolName"
        },
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "ERROR"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "calcs": {
          "description": "The new figures produced by the tool.",
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/calcResult"
          }
        },
        "result": {
          "description": "The structured result, without figures (verdicts, ids). For extract_document it contains `extraction`.",
          "type": "object"
        },
        "errors": {
          "description": "Only with status ERROR (e.g. a submit_* rejected by schema validation).",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "messageRo"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 200
              },
              "messageRo": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "extract_document"
              },
              "status": {
                "const": "OK"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "extraction"
                ],
                "properties": {
                  "extraction": {
                    "$ref": "submit_offer_extraction.json"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "errors"
            ]
          }
        }
      ]
    },
    "agentCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitTool",
        "source",
        "iterations",
        "durationMs",
        "output"
      ],
      "properties": {
        "submitTool": {
          "type": "string",
          "enum": [
            "submit_technical_assessment",
            "submit_funding_recommendation",
            "submit_underwriting_report"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "submitTool": {
                "const": "submit_technical_assessment"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "$ref": "submit_technical_assessment.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "submitTool": {
                "const": "submit_funding_recommendation"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "$ref": "submit_funding_recommendation.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "submitTool": {
                "const": "submit_underwriting_report"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "$ref": "submit_underwriting_report.json"
              }
            }
          }
        }
      ]
    },
    "agentDegradedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason",
        "attempt"
      ],
      "properties": {
        "level": {
          "description": "The fallback level that was switched to.",
          "type": "string",
          "enum": [
            "RETRY",
            "FALLBACK_MODEL",
            "CACHE",
            "GOLDEN"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "TIMEOUT",
            "THROTTLED",
            "INVALID_OUTPUT",
            "MAX_ITERATIONS",
            "UNAVAILABLE",
            "NO_NETWORK"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        },
        "detailRo": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "runCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "durationMs",
        "decision",
        "recommendedOptionId",
        "netAdvantageCalcId",
        "sources"
      ],
      "properties": {
        "state": {
          "const": "GATA"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "type": "string",
          "enum": [
            "ELIGIBLE_GREEN",
            "ELIGIBLE_WITH_CONDITIONS",
            "NOT_ELIGIBLE"
          ]
        },
        "recommendedOptionId": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "netAdvantageCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "sources": {
          "description": "Source of the output for each agent (for the badge).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "TECHNICAL_AUDITOR",
            "FUNDING_OPTIMIZER",
            "GREEN_UNDERWRITER"
          ],
          "properties": {
            "TECHNICAL_AUDITOR": {
              "$ref": "#/$defs/source"
            },
            "FUNDING_OPTIMIZER": {
              "$ref": "#/$defs/source"
            },
            "GREEN_UNDERWRITER": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "runFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "failedStep",
        "errorCode",
        "messageRo"
      ],
      "properties": {
        "state": {
          "const": "ESUAT"
        },
        "failedStep": {
          "type": "string",
          "enum": [
            "DATE_FIRMA",
            "AGENT_1",
            "AGENT_2",
            "AGENT_3"
          ]
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "FARM_DATA_UNAVAILABLE",
            "DOCUMENT_UNREADABLE",
            "DOCUMENTS_NONCONFORMING",
            "AGENT_INVALID_OUTPUT",
            "AGENT_MAX_ITERATIONS",
            "BEDROCK_UNAVAILABLE",
            "UNKNOWN_CALC_ID",
            "INTERNAL"
          ]
        },
        "messageRo": {
          "type": "string",
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
