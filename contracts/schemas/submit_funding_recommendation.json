{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.greenstruct.ro/schemas/submit_funding_recommendation.json",
  "title": "submit_funding_recommendation",
  "description": "Output-ul final al Agentului 2 (optimizator de finanțare): Opțiunea A (standard) vs. Opțiunea B (pachet verde: credit verde, garanție, grant AFIR dacă e eligibil, credit-punte, rate sezoniere). Toate cifrele sunt referite prin calcId.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "options",
    "recommendedOptionId",
    "recommendationBasis",
    "greenTier",
    "programChecks",
    "grantOutlook",
    "comparison",
    "farmerExplanationRo",
    "officerNotesRo"
  ],
  "properties": {
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "recommendedOptionId": {
      "$ref": "#/$defs/optionId"
    },
    "recommendationBasis": {
      "description": "B se recomandă doar dacă toate trei sunt adevărate (README §8, plan §6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greenEligible",
        "netAdvantagePositive",
        "affordabilityPassed"
      ],
      "properties": {
        "greenEligible": {
          "type": "boolean"
        },
        "netAdvantagePositive": {
          "type": "boolean"
        },
        "affordabilityPassed": {
          "type": "boolean"
        }
      }
    },
    "greenTier": {
      "description": "Nivelul verde al ofertei verzi (README §4, pasul 8), din determine_green_tier: VERDE_PLUS = indicatorul ≥ prag × 1,5 și DNSH trecut; VERDE = prag atins, DNSH trecut sau cu condiții; VERDE_CU_UPGRADE = investiția cerută era sub prag, iar upgrade-ul îl atinge; CLASIC = sub prag. Pentru modulele fără prag procentual (eligibile prin natura lor) lipsesc cifrele.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "thresholdMet",
        "upgradeNeeded",
        "dnshStatus"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "VERDE_PLUS",
            "VERDE",
            "VERDE_CU_UPGRADE",
            "CLASIC"
          ]
        },
        "thresholdMet": {
          "description": "Configurația finanțată de creditul verde atinge criteriul verde.",
          "type": "boolean"
        },
        "upgradeNeeded": {
          "description": "Investiția cerută nu atingea criteriul singură.",
          "type": "boolean"
        },
        "dnshStatus": {
          "description": "Statusul DNSH cel mai slab din evaluarea tehnică.",
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_CONDITIONS",
            "MISSING_DATA",
            "FAIL"
          ]
        },
        "thresholdCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "requestedIndicatorCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "financedIndicatorCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "verdePlusMinCalcId": {
          "$ref": "#/$defs/calcRef"
        }
      }
    },
    "programChecks": {
      "description": "Eligibilitatea pe fiecare program UE / garanție verificat (check_program_eligibility).",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "programCode",
          "result",
          "session",
          "checkedAt",
          "sourceUrl",
          "criteria",
          "noteRo"
        ],
        "properties": {
          "programCode": {
            "$ref": "#/$defs/programCode"
          },
          "result": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "NOT_ELIGIBLE",
              "NOT_APPLICABLE",
              "UNKNOWN"
            ]
          },
          "session": {
            "type": "string",
            "enum": [
              "OPEN",
              "NOT_OPEN",
              "CLOSED",
              "NO_BUDGET",
              "PERMANENT"
            ]
          },
          "deadline": {
            "description": "Termenul sesiunii deschise (ex. DR-12: 2026-12-02T16:00:00+02:00).",
            "type": "string",
            "format": "date-time"
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 300
          },
          "criteria": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion",
                "result"
              ],
              "properties": {
                "criterion": {
                  "type": "string",
                  "enum": [
                    "LEGAL_FORM",
                    "FARM_SIZE_SO",
                    "MANAGER_AGE",
                    "INSTALLATION_DATE",
                    "PROFESSIONAL_COMPETENCES",
                    "NEW_EQUIPMENT_ONLY",
                    "POWER_TO_AREA",
                    "PRECISION_SHARE",
                    "WATER_METERING",
                    "MIN_WATER_SAVING",
                    "GRANT_CAP",
                    "DE_MINIMIS",
                    "NO_DOUBLE_FUNDING",
                    "NO_SPENDING_BEFORE_APPLICATION",
                    "SESSION_OPEN",
                    "SME_STATUS",
                    "SECTOR_ELIGIBLE"
                  ]
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNKNOWN",
                    "NOT_APPLICABLE"
                  ]
                },
                "calcId": {
                  "$ref": "#/$defs/calcRef"
                },
                "noteRo": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          },
          "noteRo": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "grantOutlook": {
      "description": "Spunem onest ce e cu grantul: în pachet, nicio sesiune deschisă sau neeligibil. Cu dată și sursă.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "messageRo",
        "checkedAt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "GRANT_IN_STACK",
            "NO_OPEN_SESSION",
            "NOT_ELIGIBLE"
          ]
        },
        "programCode": {
          "$ref": "#/$defs/programCode"
        },
        "messageRo": {
          "type": "string",
          "maxLength": 500
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 300
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizonCalcId",
        "netAdvantageCalcId",
        "drivers",
        "rateDifference",
        "rateDifferenceCalcId"
      ],
      "properties": {
        "horizonCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "netAdvantageCalcId": {
          "description": "(economii B − plăți B − costuri B) − (economii A − plăți A − costuri A), pe orizont.",
          "$ref": "#/$defs/calcRef"
        },
        "upgradePaybackCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "drivers": {
          "description": "Din ce se compune avantajul net (pentru graficul cascadă).",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "driver",
              "calcId"
            ],
            "properties": {
              "driver": {
                "type": "string",
                "enum": [
                  "GRANT",
                  "INVESTMENT_DELTA",
                  "INTEREST",
                  "OPERATING_SAVINGS",
                  "COLLATERAL_COSTS",
                  "BRIDGE_COST"
                ]
              },
              "calcId": {
                "$ref": "#/$defs/calcRef"
              }
            }
          }
        },
        "rateDifference": {
          "description": "De ce dobânda verde e mai mică: diferența verde − clasic pe fiecare componentă (pp). Pentru tabelul din zona ofițerului.",
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "deltaCalcId"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/rateComponent"
              },
              "deltaCalcId": {
                "$ref": "#/$defs/calcRef"
              }
            }
          }
        },
        "rateDifferenceCalcId": {
          "description": "Suma diferențelor = dobânda verde − dobânda clasică (pp).",
          "$ref": "#/$defs/calcRef"
        }
      }
    },
    "farmerExplanationRo": {
      "description": "Explicația pentru fermier, limbaj simplu.",
      "type": "string",
      "maxLength": 700
    },
    "officerNotesRo": {
      "description": "Note tehnice pentru ofițer.",
      "type": "string",
      "maxLength": 1000
    }
  },
  "$defs": {
    "calcRef": {
      "type": "string",
      "pattern": "^calc_[a-f0-9]{12}$"
    },
    "configId": {
      "type": "string",
      "pattern": "^cfg_[a-z0-9_]{2,40}$"
    },
    "optionId": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "month": {
      "type": "string",
      "enum": [
        "JAN",
        "FEB",
        "MAR",
        "APR",
        "MAY",
        "JUN",
        "JUL",
        "AUG",
        "SEP",
        "OCT",
        "NOV",
        "DEC"
      ]
    },
    "programCode": {
      "type": "string",
      "enum": [
        "DR_12",
        "DR_14",
        "DR_16",
        "DR_20",
        "DR_26",
        "FM_PV",
        "INVESTEU_FEI",
        "FGCR",
        "FNGCIMM",
        "APIA_FUEL_EXCISE",
        "RABLA_AGRI"
      ]
    },
    "metric": {
      "type": "string",
      "enum": [
        "WATER_USE_M3",
        "WATER_SAVING_PCT",
        "WATER_SAVED_M3",
        "PUMPING_ENERGY_KWH",
        "ENERGY_SAVED_KWH",
        "GRID_ENERGY_REPLACED_KWH",
        "RENEWABLE_KWH",
        "FUEL_USE_L",
        "FUEL_SAVING_PCT",
        "FUEL_SAVED_L",
        "NITROGEN_USE_KG",
        "NITROGEN_SAVED_KG",
        "AREA_HA",
        "FLEET_POWER_HP",
        "PRECISION_SHARE_PCT",
        "CO2_EMITTED_T",
        "CO2_AVOIDED_T",
        "WATER_COST_SAVED_EUR",
        "ENERGY_COST_SAVED_EUR",
        "FUEL_COST_SAVED_EUR",
        "INPUTS_COST_SAVED_EUR",
        "CERTIFIED_AREA_HA"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "kind",
        "configId",
        "titleRo",
        "investmentCalcId",
        "fundingStack",
        "headlineInstallmentCalcId",
        "collateral",
        "totals",
        "annualSavings",
        "affordability",
        "greenEligible",
        "rateBreakdown"
      ],
      "properties": {
        "optionId": {
          "$ref": "#/$defs/optionId"
        },
        "kind": {
          "description": "Cardul din POST /api/runs/{id}/submit: STANDARD = CLASIC; GREEN_PACKAGE și GREEN_PACKAGE_WITH_GRANT = VERDE (opțiunea verde recomandată, dacă sunt mai multe).",
          "type": "string",
          "enum": [
            "STANDARD",
            "GREEN_PACKAGE",
            "GREEN_PACKAGE_WITH_GRANT"
          ]
        },
        "configId": {
          "description": "Configurația tehnică din submit_technical_assessment.",
          "$ref": "#/$defs/configId"
        },
        "titleRo": {
          "type": "string",
          "maxLength": 120
        },
        "investmentCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "fundingStack": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/stackItem"
          }
        },
        "headlineInstallmentCalcId": {
          "description": "Rata afișată mare pe card (lunară sau sezonieră).",
          "$ref": "#/$defs/calcRef"
        },
        "collateral": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MORTGAGE",
              "PLEDGE_EQUIPMENT",
              "GUARANTEE_INVESTEU_FEI",
              "GUARANTEE_FGCR",
              "GUARANTEE_FNGCIMM",
              "GRANT_ASSIGNMENT",
              "NONE"
            ]
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalPaymentsCalcId",
            "totalInterestCalcId",
            "savingsOverHorizonCalcId",
            "netCostCalcId"
          ],
          "properties": {
            "totalPaymentsCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "totalInterestCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "collateralCostsCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "savingsOverHorizonCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "netCostCalcId": {
              "$ref": "#/$defs/calcRef"
            }
          }
        },
        "annualSavings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "calcId"
            ],
            "properties": {
              "metric": {
                "$ref": "#/$defs/metric"
              },
              "calcId": {
                "$ref": "#/$defs/calcRef"
              }
            }
          }
        },
        "affordability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ratioCalcId",
            "limitCalcId",
            "dscrCalcId",
            "noteRo"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "PASS_WITH_WARNING",
                "FAIL"
              ]
            },
            "ratioCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "limitCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "dscrCalcId": {
              "description": "DSCR din compute_dscr: (cashflow net anual + economii anuale) / rate și dobânzi pe an, minimul pe anii creditului. Limita de 40% rămâne testul suplimentar.",
              "$ref": "#/$defs/calcRef"
            },
            "debtServiceCalcId": {
              "description": "Rate și dobânzi în cel mai greu an de credit.",
              "$ref": "#/$defs/calcRef"
            },
            "noteRo": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "greenEligible": {
          "type": "boolean"
        },
        "rateBreakdown": {
          "$ref": "#/$defs/rateBreakdown"
        }
      }
    },
    "stackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "type",
        "productId",
        "amountCalcId",
        "status",
        "noteRo"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^fs_[a-z0-9_]{2,40}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "GRANT",
            "GREEN_LOAN",
            "STANDARD_LOAN",
            "CO_FINANCING_LOAN",
            "BRIDGE_LOAN",
            "VAT_LOAN",
            "GUARANTEE",
            "ADVANCE_GUARANTEE_LETTER",
            "OWN_CONTRIBUTION"
          ]
        },
        "productId": {
          "description": "Id din config/financing-lines.json sau config/funding-programs.json.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
        },
        "programCode": {
          "$ref": "#/$defs/programCode"
        },
        "amountCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "rateCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "termCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "coverageCalcId": {
          "description": "Doar la garanții: procentul acoperit.",
          "$ref": "#/$defs/calcRef"
        },
        "guaranteesItemId": {
          "description": "Doar la garanții: creditul garantat.",
          "type": "string",
          "pattern": "^fs_[a-z0-9_]{2,40}$"
        },
        "repayment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheduleType",
            "installmentCalcId",
            "scheduleCalcId"
          ],
          "properties": {
            "scheduleType": {
              "type": "string",
              "enum": [
                "EQUAL_MONTHLY",
                "SEASONAL",
                "BULLET"
              ]
            },
            "installmentCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "scheduleCalcId": {
              "description": "Calc cu graficul complet de rambursare (pentru Recharts).",
              "$ref": "#/$defs/calcRef"
            },
            "graceCalcId": {
              "$ref": "#/$defs/calcRef"
            },
            "paymentMonths": {
              "description": "Doar la SEASONAL: lunile cu încasări din chestionar / Open Banking.",
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/month"
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "OPEN_CALL",
            "TO_CONFIRM"
          ]
        },
        "noteRo": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "rateComponent": {
      "type": "string",
      "enum": [
        "FUNDING_COST",
        "RISK_COST",
        "CAPITAL_COST",
        "OPERATIONAL_COST",
        "TARGET_PROFIT",
        "PROGRAM_SUBSIDY",
        "TIER_ADJUSTMENT"
      ]
    },
    "rateBreakdown": {
      "description": "Dobânda = indice + marjă; marja = suma componentelor (calcId pe fiecare, în puncte procentuale), din price_loan (README §4, pasul 6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexCalcId",
        "components",
        "marginCalcId",
        "rateCalcId"
      ],
      "properties": {
        "indexCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "calcId"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/rateComponent"
              },
              "calcId": {
                "$ref": "#/$defs/calcRef"
              }
            }
          }
        },
        "marginCalcId": {
          "$ref": "#/$defs/calcRef"
        },
        "rateCalcId": {
          "$ref": "#/$defs/calcRef"
        }
      }
    }
  }
}
