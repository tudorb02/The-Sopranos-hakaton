# Copy to .env (git-ignored) and fill in. Never commit .env.
# Bedrock API key (short-term keys last 12 hours and only work in the region they were issued for).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
GREENSTRUCT_BEDROCK_REGION=us-west-2
GREENSTRUCT_AGENT_MODEL_ID=us.anthropic.claude-sonnet-5-5
GREENSTRUCT_EXTRACTION_MODEL_ID=us.anthropic.claude-haiku-5-5
# Optional
GREENSTRUCT_ANALYSIS_DATE=2026-10-28
GREENSTRUCT_ANAF_ENABLED=true
